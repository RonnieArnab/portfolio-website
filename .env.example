# Copy to .env.local for `vercel dev`, and add the same key in the Vercel
# dashboard under Project → Settings → Environment Variables.
#
# Get a key at https://console.anthropic.com/settings/keys
# This powers the "Ask about me" agent (api/chat.js). Without it the chat
# returns a friendly "not configured" message and the rest of the site is fine.
ANTHROPIC_API_KEY=sk-ant-...
